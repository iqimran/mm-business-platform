# Root environment for local development (consumed by compose.yaml).
# Copy to `.env` with `make init`. Never commit `.env`.
# All values below are local-development placeholders, not real secrets.

COMPOSE_PROJECT_NAME=mm-business-platform

# Host ports (bound to 127.0.0.1). NGINX_PORT serves the Laravel API.
NGINX_PORT=8080
FRONTEND_PORT=3000

# PostgreSQL
DB_DATABASE=mm_platform
DB_USERNAME=mm_platform
DB_PASSWORD=change-me-local-only
DB_PORT=5432

# Redis
REDIS_PORT=6379

# S3-compatible object storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=mm-platform-local
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true

# Frontend → backend API base URL
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
